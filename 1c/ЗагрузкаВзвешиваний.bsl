// =====================================================================
//  Загрузка взвешиваний из АвтоВес в 1С
//  Вставьте в модуль внешней обработки / общий модуль (сервер)
//  и вызывайте ЗагрузитьВзвешивания() вручную или регламентным заданием.
// =====================================================================

Функция НастройкиАвтоВес()
	Н = Новый Структура;
	Н.Вставить("Сервер", "192.168.1.10");   // компьютер с АвтоВес
	Н.Вставить("Порт",   8080);
	Н.Вставить("Токен",  "change-me-1c-token"); // = server.api_token в config.yaml
	Возврат Н;
КонецФункции

Процедура ЗагрузитьВзвешивания() Экспорт
	Н = НастройкиАвтоВес();
	Соединение = Новый HTTPСоединение(Н.Сервер, Н.Порт, , , , 30);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Api-Token", Н.Токен);

	Запрос = Новый HTTPЗапрос("/api/1c/trips?only_new=1", Заголовки);
	Ответ  = Соединение.Получить(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "АвтоВес: ошибка " + Ответ.КодСостояния + " " + Ответ.ПолучитьТелоКакСтроку();
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
	Рейсы = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();

	Загружено = Новый Массив;
	Для Каждого Рейс Из Рейсы Цикл
		Попытка
			ОбработатьРейс(Рейс);
			Загружено.Добавить(Рейс.id);
		Исключение
			ЗаписьЖурналаРегистрации("АвтоВес", УровеньЖурналаРегистрации.Ошибка, , ,
				"Рейс " + Рейс.id + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	// Подтверждаем загрузку — эти рейсы больше не придут (пока их не изменят в АвтоВес)
	Если Загружено.Количество() > 0 Тогда
		Тело = Новый Структура("ids", Загружено);
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Тело);
		Заголовки.Вставить("Content-Type", "application/json");
		ЗапросПодтв = Новый HTTPЗапрос("/api/1c/ack", Заголовки);
		ЗапросПодтв.УстановитьТелоИзСтроки(Запись.Закрыть(), "UTF-8");
		Соединение.ОтправитьДляОбработки(ЗапросПодтв);
	КонецЕсли;

	Сообщить("АвтоВес: загружено рейсов " + Загружено.Количество());
КонецПроцедуры

